# ── Supabase (required for CRM, marketplace, auth). Public pages work without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: cron snapshots and payment webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site / white-label (one deployment per partner)
NEXT_PUBLIC_SITE_URL=https://campagrox.vercel.app
# Optional: origin used in auth email links (must be in Supabase Auth → Redirect URLs).
# AUTH_REDIRECT_ORIGIN=https://campagrox.vercel.app
NEXT_PUBLIC_BRAND_NAME=CAMPAGROX
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_COLOR=
NEXT_PUBLIC_PARTNER_SLUG=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Vercel Cron (price snapshots). Vercel sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ── Mercado Pago (subscriptions + featured listings)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Sharing a Supabase project with another app (optional)
# Install with: node scripts/build-schema-sql.mjs agrojc agrojc-listings > agrojc.sql
NEXT_PUBLIC_SUPABASE_SCHEMA=public
NEXT_PUBLIC_SUPABASE_LISTINGS_BUCKET=listings
